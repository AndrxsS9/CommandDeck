# Copia este archivo como .env.local (ignorado por Git) y completa los valores
# de tu proyecto Supabase (Project Settings → API).
#
# IMPORTANTE:
# - Usa únicamente Project URL y Publishable Key (sb_publishable_... o anon pública).
# - NUNCA uses la Secret Key (sb_secret_...) ni service_role dentro del cliente.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
