{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CommandDeck",
  "version": "0.1.0",
  "identifier": "dev.commanddeck.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CommandDeck",
        "width": 820,
        "height": 640,
        "minWidth": 540,
        "minHeight": 420,
        "resizable": true,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
